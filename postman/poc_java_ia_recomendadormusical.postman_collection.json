{
  "info": {
    "_postman_id": "a2f8d372-1b9c-4a87-a899-4c1f5db2071e",
    "name": "poc_java_ia_recomendadormusical",
    "description": "Collection para testar o recomendador musical migrado para Java 21 + Spring Boot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "vini"
    },
    {
      "key": "threadId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "02 - Iniciar conversa e salvar threadId",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('threadId', body.threadId);",
              "  pm.collectionVariables.set('threadId', body.threadId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"message\": \"Oi! Meu nome é Vini. Gosto de rock e minha banda favorita é Queen. Me recomende três músicas.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/music/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "music",
            "chat"
          ]
        }
      }
    },
    {
      "name": "03 - Continuar a mesma thread",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"threadId\": \"{{threadId}}\",\n  \"message\": \"Agora quero algo mais calmo para estudar.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/music/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "music",
            "chat"
          ]
        }
      }
    },
    {
      "name": "04 - Nova thread, mesmo usuário (testa memória longa)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"message\": \"Comecei uma conversa nova. Com base no que você já sabe sobre mim, o que recomenda?\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/music/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "music",
            "chat"
          ]
        }
      }
    },
    {
      "name": "05 - Consultar memória de longo prazo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/{{userId}}/preferences",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "{{userId}}",
            "preferences"
          ]
        }
      }
    }
  ]
}
