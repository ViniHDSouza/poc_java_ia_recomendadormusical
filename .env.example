# ==============================================================
# OpenRouter - obrigatório para chamar o LLM
# ==============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_X_TITLE=poc_java_ia_recomendadormusical
OPENROUTER_PROVIDER_SORT_BY=throughput
OPENROUTER_PROVIDER_PARTITION=none
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=2
OPENROUTER_LOG_REQUESTS=false
OPENROUTER_LOG_RESPONSES=false

# ==============================================================
# LangSmith - tracing/observabilidade (opcional, mas faz parte da aula)
# ==============================================================
# O projeto JavaScript original usa:
#   LANGSMITH_API_KEY
#   LANGCHAIN_TRACING_V2=true
#   LANGCHAIN_PROJECT=04-song-highlights
#
# Nesta migração Java o tracing é enviado ao LangSmith via OpenTelemetry/OTLP.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=04-song-highlights-java
LANGSMITH_OTLP_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
LANGSMITH_SERVICE_NAME=poc_java_ia_recomendadormusical

# Se quiser manter exatamente os nomes legados do exemplo JS, eles também são aceitos:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=04-song-highlights-java

# ==============================================================
# PostgreSQL - checkpoints do LangGraph4j / memória da thread
# ==============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=song_recommender
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# ==============================================================
# SQLite - preferências e resumo reutilizados entre threads
# ==============================================================
SQLITE_PREFERENCES_PATH=./data/preferences.db

# 6 mensagens = aproximadamente 3 trocas usuário/assistente antes do resumo.
MAX_MESSAGES_BEFORE_SUMMARY=6
